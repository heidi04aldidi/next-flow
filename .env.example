# ============================================
# NextFlow — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workflow
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/workflow

# --- PostgreSQL (Neon) ---
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Google Gemini API ---
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key

# --- Trigger.dev ---
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret_key
NEXT_PUBLIC_TRIGGER_PUBLIC_API_KEY=pk_dev_your_trigger_public_key

# --- Transloadit ---
NEXT_PUBLIC_TRANSLOADIT_KEY=your_transloadit_key
TRANSLOADIT_SECRET=your_transloadit_secret
# Transloadit template IDs
NEXT_PUBLIC_TRANSLOADIT_IMAGE_TEMPLATE_ID=your_image_upload_template_id
NEXT_PUBLIC_TRANSLOADIT_VIDEO_TEMPLATE_ID=your_video_upload_template_id

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
